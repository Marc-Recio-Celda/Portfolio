---
/**
 * SessionLoop — el bucle de una sesión, dibujado (AX-8).
 *
 * Sustituye a NexusLayers: un organigrama de tres capas decía quién es quién
 * y no decía nada de cómo se trabaja. Esto enseña el método EN MOVIMIENTO,
 * que es lo que un PI reconoce como práctica real y no como declaración.
 *
 * HTML+CSS y no SVG, por lo mismo que PipelineFlow: el argumento está en las
 * etiquetas y un SVG las encoge hasta lo ilegible en móvil.
 *
 * Los cuatro destinos van bajo "Work" porque son la regla que hace que nada
 * se pierda: una línea tachada sin destino es justo el fallo que evitan.
 */
const stations = [
  {
    tag: "Open",
    line: "Read the compass. One active front — and if today's work isn't it, that's said first.",
  },
  {
    tag: "Plan",
    line: "The subtasks in order, and why that order — written while deciding, not summarised after.",
  },
  {
    tag: "Work",
    line: "Strike each line as it goes — every one leaves as one of:",
  },
  {
    tag: "Close",
    line: "Route the residue, update what's true now, read it back from disk. The plan closes, never empties.",
  },
];

const outcomes = ["done", "to the mailbox", "to ideas", "discarded, with its reason"];
---

<figure class="loopf">
  <ol class="loopf__track">
    {
      stations.map((s) => (
        <li class="loopf__station">
          <span class="loopf__tag mono-label">{s.tag}</span>
          <p class="loopf__line">{s.line}</p>
        </li>
      ))
    }
  </ol>

  <ul class="loopf__outcomes">
    {outcomes.map((o) => <li>{o}</li>)}
  </ul>

  <p class="loopf__return">
    <span aria-hidden="true">↺</span> and the compass moves, where the next session opens
  </p>

  <figcaption class="mono-label">
    Drawn from the site's own tokens — seconds to correct when the method moves
  </figcaption>
</figure>

<style>
  .loopf {
    margin: 0;
  }

  .loopf__track {
    display: grid;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 52rem) {
    .loopf__track {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-sm);
      align-items: start;
    }
  }

  .loopf__station {
    position: relative;
    max-width: none;
    padding: var(--space-sm) var(--space-md) var(--space-md);
    border: var(--border);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--paper);
  }

  /* El conector cambia de eje con el layout: apilado en móvil, en fila
     cuando hay sitio. El último no lo lleva — ahí cierra el bucle, y eso
     lo dice la línea de retorno, no una flecha más. */
  .loopf__station::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: calc(var(--space-md) * -1);
    width: 1px;
    height: var(--space-md);
    background: color-mix(in srgb, var(--accent) 45%, var(--line));
  }
  .loopf__station:last-child::after {
    display: none;
  }
  @media (min-width: 52rem) {
    .loopf__station::after {
      left: auto;
      bottom: auto;
      top: 1.4rem;
      right: calc(var(--space-sm) * -1);
      width: var(--space-sm);
      height: 1px;
    }
  }

  .loopf__tag {
    display: block;
    color: var(--accent);
    font-size: var(--text-sm);
  }
  .loopf__line {
    margin-top: var(--space-2xs);
    max-width: none;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  /* Los cuatro destinos: fichas, no lista con viñetas — se leen de un
     vistazo y dejan claro que son un vocabulario cerrado. Van a lo ancho y no
     dentro de "Work" porque los comparten todos los pasos. */
  .loopf__outcomes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: var(--space-md) 0 0;
    padding: 0;
    list-style: none;
  }
  .loopf__outcomes li {
    max-width: none;
    padding: 0.1em 0.6em;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--line));
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 8%, var(--paper));
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent-deep);
  }

  .loopf__return {
    margin-top: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px dashed color-mix(in srgb, var(--accent) 40%, var(--line));
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent);
  }

  .loopf figcaption {
    margin-top: var(--space-sm);
  }
</style>
