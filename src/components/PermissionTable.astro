---
/**
 * PermissionTable — la tabla de permisos de escritura, renderizada (no
 * capturada): es contenido del sitio y se edita en segundos cuando el método
 * se mueve. Sustituye a la captura que envejecía con el vault.
 *
 * ⚠️ "Gated", no "Never". El bloqueo es sobre la INICIATIVA del agente, no
 * sobre sus manos (M-34): si el cambio lo origina Marc, el agente lo escribe y
 * lo registra. Pintarlo como prohibición era describir el sistema más rígido
 * de lo que es — y encima menos interesante.
 *
 * Estados sin rojo/ámbar/verde literales: la paleta es teal+índigo y la rampa
 * viridis está reservada al scatter (AX-6).
 */

type State = "gated" | "generated" | "agent";

const STATE_LABEL: Record<State, string> = {
  gated: "Gated",
  generated: "Generated",
  agent: "Agent's",
};

const BY_REQUEST = "Me — or an agent, at my request";

const rows: { state: State; what: string; who: string }[] = [
  {
    state: "gated",
    what: "Notes across the eight knowledge domains",
    who: BY_REQUEST,
  },
  {
    state: "gated",
    what: "The method itself — charter, operating prompts, indices",
    who: BY_REQUEST,
  },
  {
    state: "gated",
    what: "Each project's planning layer: state, architecture, decision log",
    who: BY_REQUEST,
  },
  {
    state: "generated",
    what: "Derived views — compiled domains, file inventory, generated HTML",
    who: "A script, from the source",
  },
  {
    state: "agent",
    what: "Scripts and tooling, the mailbox, the agent's own execution log",
    who: "The agent",
  },
];
---

<figure class="perm">
  <div class="perm__scroll">
    <table class="perm__table">
      <caption class="visually-hidden">
        Write permissions by artifact: what an AI agent may write only at my
        request, what is regenerated by a script, and what it owns outright.
      </caption>
      <thead>
        <tr>
          <th scope="col">Write access</th>
          <th scope="col">What</th>
          <th scope="col">Who writes it</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td>
              <span class={`perm__state perm__state--${r.state}`}>
                {STATE_LABEL[r.state]}
              </span>
            </td>
            <td>{r.what}</td>
            <td class="perm__who">{r.who}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <figcaption class="perm__rule">
    The rule in one sentence: an agent never changes content or
    method <em>on its own initiative</em> — what it originates goes through the
    mailbox. When the change originates with me, it writes it and logs it. The
    gate is on the origin, not on the hands.
  </figcaption>
</figure>

<style>
  .perm {
    margin: 0;
  }

  .perm__scroll {
    overflow-x: auto;
    border: var(--border);
    border-radius: var(--radius-lg);
    background: var(--paper);
  }

  .perm__table {
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .perm__table th {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--muted);
    text-align: left;
    padding: var(--space-sm) var(--space-md);
    border-bottom: var(--border);
  }

  .perm__table td {
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 60%, transparent);
    vertical-align: top;
  }

  .perm__table tbody tr:last-child td {
    border-bottom: 0;
  }

  .perm__who {
    color: var(--muted);
  }

  /* Estados: sin semáforo literal. Y sin tinta sólida en el primero — leía
     como "prohibido", que es justo lo que NO dice (M-34). Índigo = hay un
     control; gris = lo hace un script; teal = es del agente. */
  .perm__state {
    display: inline-block;
    padding: 0.1em 0.6em;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.03em;
    white-space: nowrap;
  }
  .perm__state--gated {
    background: color-mix(in srgb, var(--accent-deep) 14%, var(--paper));
    color: var(--accent-deep);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent-deep) 55%, transparent);
  }
  .perm__state--generated {
    background: color-mix(in srgb, var(--muted) 15%, var(--paper));
    color: var(--muted);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--muted) 40%, transparent);
  }
  .perm__state--agent {
    background: color-mix(in srgb, var(--accent) 15%, var(--paper));
    color: var(--accent-deep);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .perm__rule {
    max-width: var(--measure);
    margin-top: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--muted);
  }
</style>
