---
import Page from "../../layouts/Page.astro";
import { withBase } from "../../utils/url";
import { LINKS } from "../../consts";
import "../../styles/pages/work.css";
---

<Page title="All the work · Marc Recio" description="Every project of Marc Recio's portfolio, the selected work first, filtered by kind; and each tool with the projects it served." nav="work" footer="inner">
<main id="top">
  <section class="head head--plain" aria-labelledby="page-title">
    <div class="container head__inner">
      <div>
        <a class="back" href={withBase("/")}><span aria-hidden="true">←</span> Back to the landing</a>
        <p class="label"><span class="label__n">9</span>Projects</p>
        <h1 id="page-title" class="page-title">All the <span class="accent-word">work</span>.</h1>
        <p class="page-lead">Everything on this site, the selected work first. Filter it by kind, and find each tool beside the projects it served.</p>
      </div>
    </div>
  </section>

  <section class="works" aria-label="The projects">
    <div class="container">
      <fieldset class="wfilters">
        <legend class="visually-hidden">Show the projects of</legend>
        <input class="visually-hidden" type="radio" name="w" id="w-all" checked><label for="w-all">All</label>
        <input class="visually-hidden" type="radio" name="w" id="w-ai"><label for="w-ai">AI systems</label>
        <input class="visually-hidden" type="radio" name="w" id="w-data"><label for="w-data">Data science</label>
        <input class="visually-hidden" type="radio" name="w" id="w-lab"><label for="w-lab">Lab</label>
        <input class="visually-hidden" type="radio" name="w" id="w-side"><label for="w-side">Side projects</label>
      </fieldset>
      <ul class="wgrid">
        <li class="wcard k-ai k-data"><a href={withBase("/work/tfm/")}><span class="wcard__img"><img src={withBase("/work/thesis-pipeline.jpg")} alt="The thesis's pipeline figure" loading="lazy"></span><span class="wcard__body"><span class="wcard__date">Master's thesis · in progress</span><span class="wcard__title">Human-in-the-loop gene curation</span><span class="wcard__line">Language models read the papers, tested code makes the calls; the results wait for the paper and the defence.</span><span class="wcard__tags"><span class="tag">Python</span><span class="tag">Docling</span><span class="tag">LLMs</span></span></span></a></li>
        <li class="wcard k-ai"><a href={withBase("/work/aevifex/")}><span class="wcard__img"><img src={withBase("/work/aevifex/harness.jpg")} alt="The harness map, drawn small" loading="lazy"></span><span class="wcard__body"><span class="wcard__date">2026 · My method</span><span class="wcard__title">Aevifex, how I work</span><span class="wcard__line">Rules agents read first, NEXUS as my second brain, a guard, and checks tested on 688 planted faults and controls.</span><span class="wcard__tags"><span class="tag">Claude Code</span><span class="tag">Python</span><span class="tag">Bash</span></span></span></a></li>
        <li class="wcard k-lab"><a href={withBase("/work/tfm-plant-breeding/")}><span class="wcard__img"><img src={withBase("/work/plant-breeding.jpg")} alt="Microscopy of the screen, germinated grains ringed" loading="lazy"></span><span class="wcard__body"><span class="wcard__date">2024 · Plant-breeding thesis</span><span class="wcard__title">A chemical screen for heat-stressed pollen</span><span class="wcard__line">800 compounds down to 8 candidates, in an assay I designed and a robot plated.</span><span class="wcard__tags"><span class="tag">ImageJ</span><span class="tag">Statgraphics</span><span class="tag">ANOVA</span></span></span></a></li>
        <li class="wcard k-lab"><a href={withBase("/work/tfg-food-science/")}><span class="wcard__img"><img src={withBase("/work/tfg-chromatogram.jpg")} alt="A GC-MS chromatogram of a leaf oil, from the thesis" loading="lazy"></span><span class="wcard__body"><span class="wcard__date">2021 · Bachelor's thesis</span><span class="wcard__title">Essential oils of three citrus</span><span class="wcard__line">Peel and leaves of three citrus, distilled and read by GC-MS.</span><span class="wcard__tags"><span class="tag">GC-MS</span><span class="tag">ANOVA</span></span></span></a></li>
        <li class="wcard k-data"><a href={withBase("/work/ml/")}><span class="wcard__img"><img src={withBase("/work/umap.png")} alt="A UMAP projection of the Digits dataset" loading="lazy"></span><span class="wcard__body"><span class="wcard__date">2025 · Machine learning</span><span class="wcard__title">Four notebooks, end to end</span><span class="wcard__line">Clustering, ensembles, and PCA against UMAP.</span><span class="wcard__tags"><span class="tag">scikit-learn</span><span class="tag">pandas</span></span></span></a></li>
        <li class="wcard k-data"><a href={withBase("/work/r-analysis/")}><span class="wcard__img"><img src={withBase("/work/r-salary-boxplot.jpg")} alt="Gross salary by sex, from the INE survey" loading="lazy"></span><span class="wcard__body"><span class="wcard__date">2025 · Statistics</span><span class="wcard__title">Statistics in R</span><span class="wcard__line">Tests and models, read for what they mean.</span><span class="wcard__tags"><span class="tag">R</span><span class="tag">ANOVA</span></span></span></a></li>
        <li class="wcard k-data"><a href={withBase("/work/other-work/")}><span class="wcard__img"><img src={withBase("/work/viz.jpeg")} alt="A Power BI dashboard of vehicle registrations" loading="lazy"></span><span class="wcard__body"><span class="wcard__date">2025 · Data engineering</span><span class="wcard__title">Data capture &amp; databases</span><span class="wcard__line">A scraper whose dataset is on Zenodo, and its databases.</span><span class="wcard__tags"><span class="tag">Python</span><span class="tag">SQL</span></span></span></a></li>
        <li class="wcard k-side"><a href={withBase("/work/smdrop/")}><span class="wcard__img"><img src={withBase("/work/smdrop.jpg")} alt="SMDrop's pipeline, sensors to sprinkler" loading="lazy"></span><span class="wcard__body"><span class="wcard__date">Side project · frozen</span><span class="wcard__title">SMDrop</span><span class="wcard__line">Smart irrigation, RL-ready.</span><span class="wcard__tags"><span class="tag">RL</span><span class="tag">IoT</span></span></span></a></li>
        <li class="wcard k-ai k-side" id="this-site"><a href={withBase("/")}><span class="wcard__img"><img src={withBase("/work/site.jpg")} alt="This site's first screen" loading="lazy"></span><span class="wcard__body"><span class="wcard__date">2026 · Built with agents</span><span class="wcard__title">This site</span><span class="wcard__line">Designed with Claude, built with Claude Code, under rules checked in code: a reading budget per page, contrast, no client JavaScript.</span><span class="wcard__tags"><span class="tag">Astro</span><span class="tag">Claude Code</span></span></span></a></li>
      </ul>
    </div>
  </section>

  <section class="kitfull" id="toolkit" aria-labelledby="kit-title">
    <div class="container">
      <p class="label" style="--tone:var(--a-sage)"><span class="label__n">30</span>Toolkit</p>
      <h2 id="kit-title" class="h2">Each tool, and <span class="accent-word">where I used it</span>.</h2>
      <ul class="tools"><li class="tool t-data"><span class="tile__logo"><img src={withBase("/icons/tools/python.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">Python</span><span class="tool__where"><a href={withBase("/work/tfm/")}>Master's thesis</a><a href={withBase("/work/aevifex/")}>Aevifex</a><a href={withBase("/work/ml/")}>ML notebooks</a><a href={withBase("/work/other-work/")}>Data capture</a><a href={withBase("/work/smdrop/")}>SMDrop</a></span></li><li class="tool t-data"><span class="tile__logo"><img src={withBase("/icons/tools/r.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">R</span><span class="tool__where"><a href={withBase("/work/r-analysis/")}>Statistics in R</a></span></li><li class="tool t-data"><span class="tile__logo"><img src={withBase("/icons/tools/rstudio.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">RStudio</span><span class="tool__where"><a href={withBase("/work/r-analysis/")}>Statistics in R</a></span></li><li class="tool t-data"><span class="tile__logo"><img src={withBase("/icons/tools/sql.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">SQL</span><span class="tool__where"><a href={withBase("/work/other-work/")}>Data capture</a><a href={withBase("/work/tfm/")}>Master's thesis</a></span></li><li class="tool t-data"><span class="tile__logo"><img src={withBase("/icons/tools/postgresql.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">PostgreSQL</span><span class="tool__where"><a href={withBase("/work/other-work/")}>Data capture</a></span></li><li class="tool t-data"><span class="tile__logo"><img src={withBase("/icons/tools/pandas.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">pandas</span><span class="tool__where"><a href={withBase("/work/ml/")}>ML notebooks</a></span></li><li class="tool t-data"><span class="tile__logo"><img src={withBase("/icons/tools/numpy.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">NumPy</span><span class="tool__where"><a href={withBase("/work/ml/")}>ML notebooks</a></span></li><li class="tool t-data"><span class="tile__logo"><img src={withBase("/icons/tools/scikit-learn.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">scikit-learn</span><span class="tool__where"><a href={withBase("/work/ml/")}>ML notebooks</a></span></li><li class="tool t-data"><span class="tile__logo"><img src={withBase("/icons/tools/matplotlib.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">Matplotlib</span><span class="tool__where"><a href={withBase("/work/ml/")}>ML notebooks</a><a href={withBase("/work/other-work/")}>Data capture</a></span></li><li class="tool t-data"><span class="tile__logo"><img src={withBase("/icons/tools/jupyter.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">Jupyter</span><span class="tool__where"><a href={withBase("/work/ml/")}>ML notebooks</a></span></li><li class="tool t-data"><span class="tile__logo"><img src={withBase("/icons/tools/excel.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">Excel</span><span class="tool__where"><a href={withBase("/work/tfm-plant-breeding/")}>Plant-breeding thesis</a></span></li><li class="tool t-data"><span class="tile__logo"><img src={withBase("/icons/tools/power-bi.png")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">Power BI</span><span class="tool__where"><a href={withBase("/work/other-work/")}>Data capture</a></span></li><li class="tool t-ai"><span class="tile__logo"><img src={withBase("/icons/tools/claude.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">Claude Code</span><span class="tool__where"><a href={withBase("/work/aevifex/")}>Aevifex</a><a href={withBase("/work/tfm/")}>Master's thesis</a><a href="#this-site">This site</a></span></li><li class="tool t-ai"><span class="tile__logo"><img src={withBase("/icons/tools/docling.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">Docling</span><span class="tool__where"><a href={withBase("/work/tfm/")}>Master's thesis</a></span></li><li class="tool t-ai"><span class="tile__logo"><img src={withBase("/icons/tools/obsidian.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">Obsidian</span><span class="tool__where"><a href={withBase("/work/aevifex/")}>Aevifex</a></span></li><li class="tool t-dev"><span class="tile__logo"><img src={withBase("/icons/tools/git.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">Git</span><span class="tool__where"><a href={withBase("/work/aevifex/")}>Aevifex</a><a href="#this-site">This site</a></span></li><li class="tool t-dev"><span class="tile__logo"><img src={withBase("/icons/tools/github.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">GitHub</span><span class="tool__where"><a href={withBase("/work/ml/")}>ML notebooks</a><a href={withBase("/work/r-analysis/")}>Statistics in R</a><a href={withBase("/work/other-work/")}>Data capture</a><a href="#this-site">This site</a></span></li><li class="tool t-dev"><span class="tile__logo"><img src={withBase("/icons/tools/bash.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">Bash</span><span class="tool__where"><a href={withBase("/work/aevifex/")}>Aevifex</a></span></li><li class="tool t-dev"><span class="tile__logo"><img src={withBase("/icons/tools/docker.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">Docker</span><span class="tool__where"><a href={withBase("/work/smdrop/")}>SMDrop</a></span></li><li class="tool t-dev"><span class="tile__logo"><img src={withBase("/icons/tools/selenium.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">Selenium</span><span class="tool__where"><a href={withBase("/work/other-work/")}>Data capture</a></span></li><li class="tool t-dev"><span class="tile__logo"><img src={withBase("/icons/tools/astro.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">Astro</span><span class="tool__where"><a href="#this-site">This site</a></span></li><li class="tool t-dev"><span class="tile__logo"><img src={withBase("/icons/tools/draw-io.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">draw.io</span><span class="tool__where"><a href="#this-site">This site</a></span></li><li class="tool t-lab"><span class="tile__logo"><img src={withBase("/icons/tools/imagej.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">ImageJ</span><span class="tool__where"><a href={withBase("/work/tfm-plant-breeding/")}>Plant-breeding thesis</a></span></li><li class="tool t-lab"><span class="tile__logo"><img src={withBase("/icons/tools/statgraphics.png")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">Statgraphics</span><span class="tool__where"><a href={withBase("/work/tfm-plant-breeding/")}>Plant-breeding thesis</a><a href={withBase("/work/tfg-food-science/")}>Bachelor's thesis</a></span></li><li class="tool t-lab"><span class="tile__logo"><img src={withBase("/icons/tools/zenodo.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">Zenodo</span><span class="tool__where"><a href={withBase("/work/other-work/")}>Data capture</a></span></li></ul>
      <div class="also">
        <p class="minilabel" style="color:var(--a-sage)">Also in my kit</p>
        <ul class="tools tools--also"><li class="tool tool--also t-data"><span class="tile__logo"><img src={withBase("/icons/tools/kaggle.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">Kaggle</span></li><li class="tool tool--also t-ai"><span class="tile__logo"><img src={withBase("/icons/tools/antigravity.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">Antigravity</span></li><li class="tool tool--also t-ai"><span class="tile__logo"><img src={withBase("/icons/tools/cursor.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">Cursor</span></li><li class="tool tool--also t-dev"><span class="tile__logo"><img src={withBase("/icons/tools/vscode.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">VS Code</span></li><li class="tool tool--also t-dev"><span class="tile__logo"><img src={withBase("/icons/tools/linux.svg")} alt="" width="31" height="31" loading="lazy"></span><span class="tool__name">Linux</span></li></ul>
      </div>
    </div>
  </section>
</main>
</Page>
