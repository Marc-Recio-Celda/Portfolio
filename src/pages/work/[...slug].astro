---
/**
 * The smaller projects' shared page (Portfolio's D30), one template for the five: each
 * project's words and image live in its `.md` of the `work` collection, under `page` (AX-5),
 * carried word for word from the approved mockups. The entries with a page of their own (the
 * two theses, Aevifex) carry no `page` and are not built here.
 */
import { getCollection } from "astro:content";
import Page from "../../layouts/Page.astro";
import { withBase } from "../../utils/url";
import "../../styles/pages/small.css";

export async function getStaticPaths() {
  const entries = await getCollection("work", ({ data }) => !data.draft && Boolean(data.page));
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const page = Astro.props.entry.data.page!;
// An address inside the site goes through withBase (AX-2); one outside it stays as it is.
const to = (href: string) => (href.startsWith("/") ? withBase(href) : href);
---

<Page title={page.metaTitle} description={page.metaDescription} nav="inner" footer="inner">
<main id="top">
  <section class="head head--plain" aria-labelledby="page-title">
    <div class="container head__inner">
      <div>
        <a class="back" href={withBase("/work/")}><span aria-hidden="true">←</span> All the work</a>
        <p class="label"><span class="label__n">05</span>{page.label}</p>
        <h1 id="page-title" class="page-title" set:html={page.headline} />
        {page.full && <p class="page-full" set:html={page.full} />}
        <p class="page-lead" set:html={page.lead} />
        <div class="page-chips" set:html={page.chips} />
      </div>
    </div>
  </section>
  <section class="small" aria-label="The project">
    <div class="container">
      <figure class="shot reveal"><img src={withBase(page.shot.src)} alt={page.shot.alt} loading="lazy"><figcaption class="caption" set:html={page.shot.caption} /></figure>
      <div class="trio reveal">
        {page.blocks.map((b) => <div class="blk"><h2>{b.heading}</h2><Fragment set:html={b.html} /></div>)}
      </div>
      {page.paper && <Fragment set:html={page.paper} />}
      <div class="tail reveal"><div class="stack">{page.stack.map((t) => <span class="tag">{t}</span>)}</div><div class="foot__actions">{page.actions.map((a) => <a class={a.dark ? "btn btn--dark" : "btn"} href={to(a.href)}>{a.label} <span class="arrow" aria-hidden="true">→</span></a>)}</div></div>
    </div>
  </section>
</main>
</Page>
